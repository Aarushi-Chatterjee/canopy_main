# ============================================================
# CANOPY SERVER ENVIRONMENT VARIABLES
# Copy this file to .env and configure your Supabase project
# ============================================================

# Supabase Project Credentials
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional Direct PostgreSQL Connection String
# Found in: Supabase Dashboard -> Project Settings -> Database
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres

# Canopy Server Security
# JWT Secret for signing field station tokens (minimum 32 characters required in production)
JWT_SECRET=canopy_jwt_secret_replace_in_production_min_32_characters

# Founder & Administrator Bootstrap Allowlist (comma-separated verified emails)
# Stored on server only; never sent to browser or committed with real production secrets
FOUNDER_EMAILS=founder@canopy.earth,aarushi@canopy.earth

# Email Service Configuration (supports 'console', 'test', 'resend', 'smtp')
EMAIL_PROVIDER=console
MAIL_FROM="Canopy Dispatch <hello@canopy.earth>"
SUPPORT_EMAIL="support@canopy.earth"
PRIVACY_EMAIL="privacy@canopy.earth"
# RESEND_API_KEY=re_123456789

# Canopy API Gateway Server Port
PORT=3001
NODE_ENV=development


