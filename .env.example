# ============================================================
# CANOPY SERVER ENVIRONMENT VARIABLES (TEMPLATE)
# Copy this file to .env and configure for your local/staging environment.
# Never commit real secrets or founder email addresses to source control.
# ============================================================

# Supabase Project Credentials
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=

# Optional Direct PostgreSQL Connection String
DATABASE_URL=

# Canopy Server Security
# CRITICAL: JWT_SECRET must be generated using at least 32 cryptographically secure random bytes
# Example generator: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Operational Staff & Internal Access Control (Optional)
# Comma-separated list of operational staff email accounts.
# Set this in your secure hosting/deployment dashboard only.
INTERNAL_OPERATOR_EMAILS=

# Internal Operations Key (Optional Header Gate)
# Example generator: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
INTERNAL_OPS_KEY=

# Email Service Configuration
# EMAIL_PROVIDER options: 'smtp' (Gmail/Nodemailer), 'resend', 'console' (local preview), 'test'
EMAIL_PROVIDER=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
SUPPORT_EMAIL=
PRIVACY_EMAIL=

# Optional Resend API Key if using Resend with custom verified domain:
RESEND_API_KEY=

# Canopy API Gateway Server Port & Environment
PORT=3001
NODE_ENV=development

# Mythos SDK (required: >=32 chars, generate with: openssl rand -base64 32)
MYTHOS_SESSION_SECRET=
# Required unless resolveListingIds is passed to createMythos()
MYTHOS_LISTING_ID=
# Optional
# MYTHOS_API_URL=https://api.mythos.work
# MYTHOS_DEBUG=1
